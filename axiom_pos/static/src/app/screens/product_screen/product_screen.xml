<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="axiom_pos.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//ProductCard" position="attributes">
            <attribute name="price">getProductPrice(product)</attribute>
            <attribute name="productInfo">pos.axiomCashierCanViewProductInfo()</attribute>
        </xpath>
        <xpath expr="//div[hasclass('product-reminder')]" position="attributes">
            <attribute name="t-if">pos.axiomCashierHasShowProductPrice() and pos.get_order().get_selected_orderline() and pos.hasJustAddedProduct</attribute>
        </xpath>
    </t>

</templates>
