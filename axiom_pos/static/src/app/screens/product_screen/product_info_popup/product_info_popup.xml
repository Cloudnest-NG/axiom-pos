<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="axiom_pos.ProductInfoPopup" t-inherit="point_of_sale.ProductInfoPopup" t-inherit-mode="extension">
        <!-- Hide warehouse on-hand / forecast inventory section -->
        <xpath expr="//div[hasclass('section-inventory')]" position="attributes">
            <attribute name="t-if">pos.axiomCashierCanViewProductInfo() and !isVariant and props.info.productInfo.warehouses.length > 0</attribute>
        </xpath>
    </t>

</templates>
