<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_axiom_pos" model="ir.module.category">
        <field name="name">Axiom POS</field>
        <field name="description">Granular access rights for the Point of Sale.</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_show_product_price" model="res.groups">
        <field name="name">Show Product Prices</field>
        <field name="category_id" ref="module_category_axiom_pos"/>
        <field name="comment">Allows the cashier to see unit prices on product cards and order lines in the POS.</field>
    </record>

    <record id="group_enable_draft_printing" model="res.groups">
        <field name="name">Enable Draft Printing</field>
        <field name="category_id" ref="module_category_axiom_pos"/>
        <field name="comment">Allows printing pro forma / draft bills before the order is paid.</field>
    </record>

    <record id="group_reprint_paid_orders" model="res.groups">
        <field name="name">Reprint Paid Orders</field>
        <field name="category_id" ref="module_category_axiom_pos"/>
        <field name="comment">Allows reprinting paid order receipts when paid reprint lock is enabled on the POS config.</field>
    </record>

    <record id="group_view_product_info" model="res.groups">
        <field name="name">View Product Info / On Hand</field>
        <field name="category_id" ref="module_category_axiom_pos"/>
        <field name="comment">Allows opening the product info card and seeing on-hand quantity in the POS (when access is set to POS Administrators).</field>
    </record>

    <!-- Cashiers see product prices by default; draft/reprint/info stay admin-controlled. -->
    <record id="point_of_sale.group_pos_user" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('axiom_pos.group_show_product_price')),
        ]"/>
    </record>

    <!-- POS Administrators inherit all Axiom POS rights by default. -->
    <record id="point_of_sale.group_pos_manager" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('axiom_pos.group_show_product_price')),
            (4, ref('axiom_pos.group_enable_draft_printing')),
            (4, ref('axiom_pos.group_reprint_paid_orders')),
            (4, ref('axiom_pos.group_view_product_info')),
        ]"/>
    </record>
</odoo>
