<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Match pos_event: overlay badge as direct child of article -->
    <t t-name="axiom_pos.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//article" position="inside">
            <div t-if="axiomDisplayPrice"
                 t-att-class="axiomPricePositionClass"
                 t-att-style="axiomPriceStyleString"
                 t-esc="axiomDisplayPrice"/>
        </xpath>
    </t>

</templates>
