<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="axiom_pos.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//button[contains(@t-on-click, 'doPrint')]" position="attributes">
            <attribute name="t-if">pos.axiomCashierCanReprintPaid()</attribute>
        </xpath>

        <!-- Header column for print (desktop), next to trash -->
        <xpath expr="//div[hasclass('header-row')]/div[@name='delete']" position="before">
            <div class="col very-narrow p-2" name="print"/>
        </xpath>

        <!-- Desktop rows: print icon between status and trash (draft and paid) -->
        <xpath expr="//div[hasclass('order-row')][not(hasclass('mobileOrderList'))]/div[hasclass('narrow')]" position="after">
            <div t-if="axiomCanShowOrderPrint(order)"
                 class="col very-narrow p-2 axiom-order-print-button"
                 name="print"
                 t-on-click.stop="() => this.axiomPrintOrderRow(order)"
                 title="Print Order">
                <i class="fa fa-print" aria-hidden="true"/>
            </div>
            <div t-else="" class="col very-narrow p-2"/>
        </xpath>

        <!-- Mobile actions column: print next to trash -->
        <xpath expr="//div[hasclass('mobileOrderList')]/div[hasclass('col')][last()]" position="replace">
            <div class="col p-2 d-flex gap-1 align-items-center">
                <div t-if="axiomCanShowOrderPrint(order)"
                     class="col very-narrow delete-button p-2 rounded-2 axiom-order-print-button"
                     name="print"
                     t-on-click.stop="() => this.axiomPrintOrderRow(order)">
                    <i class="fa fa-print me-1" aria-hidden="true"/> Print
                </div>
                <div t-if="!shouldHideDeleteButton(order)"
                     class="col very-narrow delete-button p-2 rounded-2"
                     name="delete"
                     t-on-click.stop="() => this.pos.onDeleteOrder(order)">
                    <i class="fa fa-trash" aria-hidden="true"/> Delete
                </div>
            </div>
        </xpath>
    </t>

</templates>
