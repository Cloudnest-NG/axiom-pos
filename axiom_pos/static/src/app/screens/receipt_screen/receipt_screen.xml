<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="axiom_pos.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('print')][1]" position="attributes">
            <attribute name="t-if">axiomCanPrint</attribute>
        </xpath>
        <xpath expr="//button[hasclass('print')][2]" position="attributes">
            <attribute name="t-if">axiomCanPrint and pos.config.basic_receipt</attribute>
        </xpath>
    </t>

</templates>
